        <ids:classification>
          <ids:system>
            <xs:restriction base="xs:string">
              <xs:pattern value=".+" />
            </xs:restriction>
          </ids:system>
        </ids:classification>
      </ids:applicability>
      <ids:requirements>
        <ids:property cardinality="required">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value="Qto_.*|.*BaseQuantities" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Count" />
              <xs:enumeration value="GrossVolume" />
