      <ids:requirements>
        <ids:property dataType="IFCLENGTHMEASURE" cardinality="optional">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value="Qto_.*|.*BaseQuantities" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Length" />
              <xs:enumeration value="Perimeter" />
              <xs:enumeration value="Width" />
              <xs:enumeration value="Height" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCAREAMEASURE" cardinality="optional">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value="Qto_.*|.*BaseQuantities" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:enumeration value="GrossArea" />
              <xs:enumeration value="NetArea" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCVOLUMEMEASURE" cardinality="optional">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value="Qto_.*|.*BaseQuantities" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:enumeration value="GrossVolume" />
              <xs:enumeration value="NetVolume" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCCOUNTMEASURE" cardinality="optional">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value="Qto_.*|.*BaseQuantities" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Count" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCMASSMEASURE" cardinality="optional">
          <ids:propertySet>
            <xs:restriction base="xs:string">
              <xs:pattern value="Qto_.*|.*BaseQuantities" />
            </xs:restriction>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:enumeration value="GrossWeight" />
              <xs:enumeration value="NetWeight" />
              <xs:enumeration value="Weight" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification name="Classification references carry a code" ifcVersion="IFC4 IFC4X3_ADD2" description="The reference's Identification is the code pay items key on." instructions="Set Identification on every IfcClassificationReference.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCCLASSIFICATIONREFERENCE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name>
            <ids:simpleValue>Identification</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
