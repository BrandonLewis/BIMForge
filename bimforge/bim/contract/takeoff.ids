  <ids:info>
    <ids:title>bimforge takeoff contract</ids:title>
    <ids:description>What an IFC must carry for est-bim takeoff to roll it up into pay quantities: classification codes as the pay-item key and Qto quantities as the measure. Generated by bimforge.bim.takeoff_ids.</ids:description>
    <ids:purpose>Quantity takeoff</ids:purpose>
  </ids:info>
  <ids:specifications>
    <ids:specification name="Classified elements carry a quantity to measure" ifcVersion="IFC4 IFC4X3_ADD2" description="An element with a classification code is a pay item. The takeoff sums one of its quantities; with none of these it is skipped and the pay item comes up short." instructions="Give the element a quantity set named Qto_* or *BaseQuantities holding at least one of: Count, GrossVolume, NetVolume, GrossArea, NetArea, Length, GrossWeight, NetWeight, Weight.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCACTUATOR" />
              <xs:enumeration value="IFCAIRTERMINAL" />
