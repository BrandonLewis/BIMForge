    <ids:specification name="Quantities are stored as their own dimension" ifcVersion="IFC4 IFC4X3_ADD2" description="The takeoff scales a quantity by the unit of the dimension its name implies, so an area stored as a length is scaled wrongly." instructions="Store each named quantity as the matching IfcQuantity type (GrossArea as IfcQuantityArea, Length as IfcQuantityLength, ...).">
