              <xs:enumeration value="GrossArea" />
              <xs:enumeration value="NetArea" />
              <xs:enumeration value="Length" />
              <xs:enumeration value="GrossWeight" />
              <xs:enumeration value="NetWeight" />
              <xs:enumeration value="Weight" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
